% Change from the RETFound anchor after adding RetinAgent.
% Required preamble package: \usepackage{tikz}
% Point estimates come from equi_agent_current_results.tex on 2026-08-24.
% Add paired bootstrap intervals once all case-level prediction artifacts have
% been reconciled on CECSL; do not infer intervals from aggregate metrics.

\definecolor{DeltaGain}{HTML}{007C91}
\definecolor{DeltaLoss}{HTML}{D55E00}
\definecolor{DeltaNeutral}{HTML}{687784}
\definecolor{FigureText}{HTML}{202124}

% #1 y position, #2 cohort name, #3 test cohort size.
\newcommand{\CohortLabel}[3]{%
  \node[anchor=east,text=FigureText,font=\fontsize{6.4}{6.7}\selectfont]
    at (2.82,#1) {#2};%
  \node[anchor=west,text=black!52,font=\fontsize{5.5}{5.8}\selectfont]
    at (2.89,#1) {$n=#3$};%
}

% #1 zero x coordinate, #2 y position, #3 paired metric change, #4 color.
\newcommand{\DeltaMark}[4]{%
  \draw[#4,line width=1.15pt] (#1,#2) -- ({#1+8.5*#3},#2);%
  \fill[#4] ({#1+8.5*#3},#2) circle[radius=2.25pt];%
}

% #1 zero x coordinate, #2 panel title, #3 panel letter.
\newcommand{\DeltaAxis}[3]{%
  \node[anchor=west,text=FigureText,font=\bfseries\fontsize{8.2}{8.5}\selectfont]
    at ({#1-2.15},1.52) {\textbf{#3}\quad #2};%
  \node[anchor=east,text=black!55,font=\fontsize{5.5}{5.8}\selectfont]
    at ({#1-0.16},1.00) {Favours RETFound};%
  \node[anchor=west,text=black!55,font=\fontsize{5.5}{5.8}\selectfont]
    at ({#1+0.16},1.00) {Favours RetinAgent};%
  \foreach \tick/\ticklabel in {
    -0.2/$-0.2$,-0.1/$-0.1$,0/$0$,0.1/$+0.1$,0.2/$+0.2$,0.3/$+0.3$} {%
    \draw[black!10,line width=0.35pt]
      ({#1+8.5*\tick},0.70) -- ({#1+8.5*\tick},-6.22);%
    \node[anchor=north,text=black!60,font=\fontsize{5.6}{5.8}\selectfont]
      at ({#1+8.5*\tick},-6.35) {\ticklabel};%
  }%
  \draw[black!55,line width=0.7pt] (#1,0.70) -- (#1,-6.22);%
  \node[anchor=north,text=black!65,font=\fontsize{5.8}{6.0}\selectfont]
    at (#1,-7.03) {RetinAgent $-$ RETFound};%
}

\begin{tikzpicture}[x=1cm,y=0.78cm]

\DeltaAxis{5.12}{$\Delta$ F1 score}{a}
\DeltaAxis{11.42}{$\Delta$ balanced accuracy}{b}

\node[anchor=east,text=black!68,font=\bfseries\fontsize{5.8}{6.0}\selectfont]
  at (2.82,0.57) {Primary locked cohorts};
\node[anchor=east,text=black!68,font=\bfseries\fontsize{5.8}{6.0}\selectfont]
  at (2.82,-2.15) {External stress tests};

\CohortLabel{0.00}{FairVision30K}{250}
\CohortLabel{-1.00}{Harvard GDP}{250}
\CohortLabel{-2.85}{Drishti-GS1}{51}
\CohortLabel{-3.85}{REFUGE2}{400}
\CohortLabel{-4.85}{PAPILA}{81}
\CohortLabel{-5.85}{GAMMA}{20}

% Panel a: paired F1 changes versus RETFound.
\DeltaMark{5.12}{0.00}{0.0227}{DeltaGain}
\DeltaMark{5.12}{-1.00}{0.1225}{DeltaGain}
\DeltaMark{5.12}{-2.85}{0.2535}{DeltaGain}
\DeltaMark{5.12}{-3.85}{0.0242}{DeltaGain}
\DeltaMark{5.12}{-4.85}{-0.1833}{DeltaLoss}
\DeltaMark{5.12}{-5.85}{0.0000}{DeltaNeutral}

% Panel b: paired balanced-accuracy changes versus RETFound.
\DeltaMark{11.42}{0.00}{0.0204}{DeltaGain}
\DeltaMark{11.42}{-1.00}{0.0786}{DeltaGain}
\DeltaMark{11.42}{-2.85}{0.1993}{DeltaGain}
\DeltaMark{11.42}{-3.85}{0.0565}{DeltaGain}
\DeltaMark{11.42}{-4.85}{-0.1666}{DeltaLoss}
\DeltaMark{11.42}{-5.85}{0.0000}{DeltaNeutral}

\fill[DeltaGain] (3.00,-7.78) circle[radius=2pt];
\node[anchor=west,text=FigureText,font=\fontsize{5.8}{6.0}\selectfont]
  at (3.16,-7.78) {Improvement};
\fill[DeltaLoss] (5.20,-7.78) circle[radius=2pt];
\node[anchor=west,text=FigureText,font=\fontsize{5.8}{6.0}\selectfont]
  at (5.36,-7.78) {Decline};
\fill[DeltaNeutral] (7.05,-7.78) circle[radius=2pt];
\node[anchor=west,text=FigureText,font=\fontsize{5.8}{6.0}\selectfont]
  at (7.21,-7.78) {No change};

\end{tikzpicture}
